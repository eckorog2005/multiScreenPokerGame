{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "nodenext",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,

    /* Apps import the .ts source directly, so Node must be able to strip it */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
