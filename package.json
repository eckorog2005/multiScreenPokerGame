{
  "name": "multi-screen-poker",
  "private": true,
  "description": "Multi-screen poker game: a shared table screen plus each player's phone as their private hand",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm test",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=26"
  },
  "author": "Roger Lamb",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
