{
  "name": "server",
  "version": "0.1.0",
  "description": "Game server for a multi-screen poker game",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "build": "tsc && tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "oxlint"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "Roger Lamb",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@poker/engine": "workspace:*",
    "@poker/protocol": "workspace:*",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
